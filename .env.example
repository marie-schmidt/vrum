# Local configuration for docker compose. Copy to .env (git-ignored), or run
# ./scripts/init-env.sh, which creates .env with a random database password.

# Required. There is no default.
VRUM_DB_PASSWORD=
# There is no token to set. A person registers an account on the board (http://127.0.0.1:8000/board),
# creates a private project there, and gives each agent a key for that one project (Agent access on
# the project's board).
# For the helper scripts in scripts/ (the server does not read it): the agent key of one project.
# VRUM_AGENT_KEY=

# Optional.
VRUM_PORT=8000
VRUM_BIND_ADDRESS=127.0.0.1
# The most bytes one request may hold (4 MiB by default). A bigger one is refused with a plain
# message. It is the only limit on what one write may contain.
# VRUM_MAX_REQUEST_BYTES=4194304
# How often the board (http://127.0.0.1:8000/board) asks the server what changed, in seconds (5 by
# default, 0.5 at the least). What an agent does shows on the board within this long.
# VRUM_BOARD_POLL_SECONDS=5

# Optional: an embedding service, for search by meaning, similar items and overlaps. Any
# OpenAI-compatible one works. Set both, or neither (then search works by exact words only).
# To run one on this machine: uncomment these two lines and start the stack with
#   docker compose --profile local-embeddings up -d --build --wait
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL=all-minilm
# EMBEDDING_API_KEY=            # if the service wants one (or put the path of a file in EMBEDDING_API_KEY_FILE)
# EMBEDDING_MAX_CHARS=2000      # the most text of one item sent to the model
# EMBEDDING_MIN_SIMILARITY=0.35 # how alike (0 to 1) to be found by meaning; measured for all-minilm
# EMBEDDING_OVERLAP_THRESHOLD=0.55  # how alike (0 to 1) to be reported as an overlap; measured for all-minilm
# EMBEDDING_REINDEX_SECONDS=5   # how often the server looks for items to index

# Optional: a language model, for extract_facts, consolidate_memory, find_contradictions and
# reflect. Any OpenAI-compatible chat service works (this server asks it for JSON). Set both, or
# neither (then those four tools say no model is set up, and everything else works). Nothing is
# sent anywhere unless you set a URL, and text containing a well-known secret format is never sent.
# Small local models follow the quoting rules less reliably than large ones: the server checks
# every proposal and drops what does not check out, so a weak model gives fewer results, not
# wrong ones. To use Ollama installed on this machine (tried with llama3.2, 3 billion parameters):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=                  # if the service wants one (or put the path of a file in LLM_API_KEY_FILE)
# LLM_TIMEOUT_SECONDS=120       # how long to wait for one answer
# LLM_MAX_INPUT_CHARS=12000     # the most text sent to the model in one request (about 3,000 tokens:
#                               # Ollama gives a model 4,096 tokens by default; raise it with the model's)
