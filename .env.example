# Local configuration for docker compose. Copy to .env (git-ignored), or run
# ./scripts/init-env.sh, which creates .env with a random database password.

# Required. There is no default.
VRUM_DB_PASSWORD=

# Optional.
VRUM_PORT=8000
VRUM_BIND_ADDRESS=127.0.0.1

# Optional: an embedding service, for search by meaning, similar items and overlaps. Any
# OpenAI-compatible one works. Set both, or neither (then search works by exact words only).
# To run one on this machine: uncomment these two lines and start the stack with
#   docker compose --profile local-embeddings up -d --build --wait
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL=all-minilm
# EMBEDDING_API_KEY=            # if the service wants one (or put the path of a file in EMBEDDING_API_KEY_FILE)
# EMBEDDING_MAX_CHARS=2000      # the most text of one item sent to the model
# EMBEDDING_MIN_SIMILARITY=0.35 # how alike (0 to 1) to be found by meaning; measured for all-minilm
# EMBEDDING_OVERLAP_THRESHOLD=0.55  # how alike (0 to 1) to be reported as an overlap; measured for all-minilm
# EMBEDDING_REINDEX_SECONDS=5   # how often the server looks for items to index
